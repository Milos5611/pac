{
  "name": "api",
  "version": "2.0.0",
  "description": "PAC conference GraphQL API (LoopBack 4)",
  "private": true,
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "dev": "nodemon -e ts -w src -d 2 -x \"lb-tsc && node --env-file-if-exists=.env --inspect=9202 -r source-map-support/register . || exit 1\"",
    "lint": "npm run prettier:check && npm run eslint",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "npm run prettier:cli -- -l",
    "prettier:fix": "npm run prettier:cli -- --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "npm run eslint -- --fix",
    "pretest": "npm run clean && npm run build",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "posttest": "npm run lint",
    "test:dev": "lb-mocha --allow-console-logs dist/__tests__/**/*.js && npm run posttest",
    "docker:build": "docker build -t pac_mnikolic_api .",
    "docker:run": "docker run -p 3000:3000 -d pac_mnikolic_api",
    "migrate": "node --env-file-if-exists=.env ./dist/migrate",
    "seed": "node --env-file-if-exists=.env ./dist/seed",
    "openapi-spec": "node ./dist/openapi-spec",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env -r source-map-support/register .",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache"
  },
  "repository": {
    "type": "git"
  },
  "author": "",
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/boot": "^9.0.0",
    "@loopback/core": "^8.0.0",
    "@loopback/graphql": "^0.15.0",
    "@loopback/logging": "^0.14.0",
    "@loopback/metrics": "^0.16.0",
    "@loopback/repository": "^9.0.0",
    "@loopback/rest": "^16.0.0",
    "@loopback/service-proxy": "^9.0.0",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "loopback-connector-postgresql": "^9.0.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@loopback/build": "^13.0.0",
    "@loopback/eslint-config": "^17.0.0",
    "@loopback/testlab": "^9.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "source-map-support": "^0.5.21",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "overrides": {
    "@loopback/core": "$@loopback/core",
    "@loopback/rest": "$@loopback/rest",
    "@loopback/boot": "$@loopback/boot",
    "graphql": "$graphql"
  }
}
